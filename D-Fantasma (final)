#include <iostream>
#include <sstream>
#include <vector>
using namespace std;

int main() {
    int f; // numero de listas
    cin >> f;
    cin.ignore();

    vector<vector<int>> listas;

    // LLEEGIR TOTES LES LLISTES
    for (int ct = 0; ct < f; ct++) {
        string linea;
        getline(cin, linea);

        istringstream iss(linea);
        vector<int> a;
        int num;

        while (iss >> num) {
            a.push_back(num);
        }

        listas.push_back(a);
    }
    int k = 0;
    // PROCESAR I MOSTRAR DESPRÉS
    for (int ct = 0; ct < f; ct++) {
        vector<int> a = listas[ct];
        int n = a.size();

        /*cout << "Lista " << ct + 1 << " original (" << n << "): ";
        for (int x : a) cout << x << " ";
        cout << endl;*/

        // ELIMINAR CEROS
        int i = 0;
        while (i < n-1) {
            if (a[i] == 0) {
                for (int j = i; j < n - 1; j++) { //moure a l'esquerra
                    a[j] = a[j + 1];
                }
                n--;
                i = 0;
            } else {
                i++;
            }
        }

        /*cout << "Sin 0 (" << n << "): ";
        for (int i = 0; i < n; i++) cout << a[i] << " ";
        cout << endl;*/
        
        
        //MIRAR SI HI HA NUMEROS NEGATIUS
        k = 5;
        for (int i = 0; i < n-1; i++) {
            if (a[i] < 0) { //hi ha numero negatiu
                k = 5;
                i = n-1;
            } else {
                i++;
            }
        }
        
// COMPROBAR
        // LOGICA
        
        if (n % 2 != 0) {
            k = 5;
        }
        i = 0;    
        /*(n > 0 && a[0] < 0) || (n > 0 && a[n - 1] > 0) {*/
        
        int j = 0;
        i = 0;
        //CERCAR PRIMER NUMERO NEGASÇTIU (NUMERO QUE ES LLEVA) I VOMPARAR-LO AMB EL SEU PRECURSOR (ha de ser el mateix amb canvi de signe
        while (k == 0 && i < n - 1) {
            if (a[i] < 0) { // numero negatiu
                j = i - 1;
                if (-a[j] != a[i]) {
                    k = 5;
                    //break;
                }
                if (-a[j] == a[i]){
                    for (int x = j; x < n - 2; x++) { // eliminar parejaj de numeros
                        a[x] = a[x + 2];
                    }
                    n = n-2;
                    i = 0;
                } else {
                    i++;
                }       
            }
        }

        /*cout << "Final (" << n << "): ";
        for (int i = 0; i < n; i++) cout << a[i] << " ";
        cout << endl;*/

        if (k == 5){
            cout << "PARANORMAL" << endl;
        }
        if (k == 0){
            cout << "NORMAL" << endl;
        }
        //cout << "-------------------" << endl;
        }

    return 0;
}
