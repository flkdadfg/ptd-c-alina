#include <iostream>
#include <sstream>
#include <vector>
using namespace std;

int main() {
    string linea;
    cout << "Dime una lista de numeros:" << endl;
    getline(cin, linea);

    istringstream iss(linea);
    vector<int> a;   // lista de números
    int num;

    // Guardar todos los números en el vector a
    while (iss >> num) {
        a.push_back(num);
    }

    // Crear t como copia de a
    vector<int> t = a;

    // Mostrar cantidad de números
    cout << "Tu lista de numeros tiene " << t.size() << " numeros" << endl;

    // Mostrar la lista completa
    cout << "La lista de numeros es: ";
    for (int i = 0; i < t.size(); i++) {
        cout << t[i] << " ";
    }
    cout << endl;

    return 0;
}
