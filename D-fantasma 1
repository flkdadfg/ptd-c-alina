#include <iostream>
#include <sstream>
#include <vector>
using namespace std;

int main() {
    string linea;
    //cout << "Introdueix la llista de llibres" << endl;
    getline(cin, linea);
    
    istringstream iss(linea);
    
    vector<int> a;   // llista
    int num;    //en numeros

    // Guardar tots els numeros en el vector
    while (iss >> num) {
        a.push_back(num);   //posa numeros a "a"
    }
    int n = a.size(); //n = numero de llibres/numeros
    int i = 0; //recoredor de la llista
    //LLEVAR 0 (movent a l'esquerra)
        while (i<n) {
            if (a[i] == 0) { //moure numeros
                for (int j = i; j < n -1; j++) {
                    a[j] = a[j+1];
                }
                n--; //la llista ara te un element menys (el 0 que s'ha llevat)
            } else {
                i++; //si no hi ha 0 avançam per trbar els 0
            }
        }
    //COMENÇAR A COMPROVAR SI HI HA O NO FANTASMA
    int k = 0; // si k es 0 tot be si k es 5 malament
        if (n%2 != 0){ //numero es impar --> el fantasma ha afegit o llevat llibres
            k = 5;
        }
    
    
    // MOSTRAR LLISTA DE LLIBRES
    cout << "llista de llibres sensen 0 te: " << n << " llibres/components" << endl;
    cout << "llista de llibres sensen 0 es: ";
    for (int i=0; i<n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;
    
    if (k == 5) {
        cout << "malament" << endl;
    }
    else {
        cout << "be" << endl;
    }
    return 0;
}
